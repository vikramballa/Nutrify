generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // pg_trgm backs the GIN index on Recipe.nameLower: recipe search is a
  // `contains` (LIKE '%term%'), which a plain btree index cannot serve.
  extensions = [pg_trgm]
}

model User {
  id           String          @id @default(uuid())
  email        String          @unique
  passwordHash String
  deviceId     String?         @unique
  name         String          @default("Sarah")
  onboarded    Boolean         @default(false)
  age          Int?
  heightCm     Float?
  weightKg     Float?
  sex          String? // 'male' | 'female'
  activityLevel String? // 'sedentary' | 'light' | 'moderate' | 'active' | 'very_active'
  goal         String? // 'lose_weight' | 'maintain' | 'gain_weight' | 'build_muscle'
  conditions   String[]        @default([])
  // When the user agreed to send their photos and health profile to the
  // third-party AI provider (App Store 5.1.2(i)). Null = not agreed / revoked.
  aiConsentAt  DateTime?
  goals        NutritionGoals?
  grocery      GroceryItem[]
  events       UserEvent[]
  mealLogs     MealLog[]
  favorites    Favorite[]
  mealPlan     MealPlanEntry[]
  waterLogs    WaterLog[]
  weightEntries WeightEntry[]
  refreshTokens RefreshToken[]
  chatMessages ChatMessage[]
  mealScanCorrections MealScanCorrection[]
  recipeSuggestions RecipeSuggestion[]
  dishes       UserDish[]
  foods        UserFood[]
  createdAt    DateTime        @default(now())
}

// What the user taught the meal scanner: "when you say X, it's actually Y".
// Keyed on the model's own wording, normalised (see mealCorrections.ts), so
// the next scan that says X is renamed to Y and the prompt carries the hint.
// The newest answer for a key wins; a "no" on a learned name replaces it.
model MealScanCorrection {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  predictedKey  String
  predictedName String
  correctName   String
  // How often a scan was renamed with this correction and the user said yes.
  confirmations Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, predictedKey])
  @@index([userId, updatedAt])
}

// One turn of the Ask NutriChef thread. A user has a single rolling
// conversation; ordering is by createdAt, and an edit deletes everything after
// the edited turn so the thread stays consistent with what the model saw.
model ChatMessage {
  id        String   @id @default(uuid())
  // Ordering key. createdAt cannot do this job: Postgres now() is
  // transaction-scoped, so a question and its answer written in one
  // transaction share a timestamp. A sequence still increments per row.
  seq       Int      @unique @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String // 'user' | 'assistant'
  content   String
  createdAt DateTime @default(now())

  @@index([userId, seq])
}

// Opaque 30-day refresh tokens; only the SHA-256 hash is stored. Rotated on
// every use — the old row is revoked (revokedAt) when a new pair is issued.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// A meal the user actually ate: nutrition snapshotted at log time so later
// recipe edits don't rewrite history.
model MealLog {
  id       String   @id @default(uuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipeId String?
  recipe   Recipe?  @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  name     String
  mealType String // 'breakfast' | 'lunch' | 'dinner' | 'snack'
  calories Int
  protein  Int
  carbs    Int
  fat      Int
  at       DateTime @default(now())

  @@index([userId, at])
  // "Recent meals": the newest row per dish name (DISTINCT ON name).
  @@index([userId, name, at(sort: Desc)])
  @@index([recipeId])
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipeId  String
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, recipeId])
  @@index([recipeId])
}

// A planned meal for a day slot. Recipe entries cascade away with the recipe;
// custom entries (customName) carry no nutrition and count as 0 in totals.
// Multiple entries per (user, day, slot) are allowed.
model MealPlanEntry {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date // a calendar day, no time part
  slot       String // 'breakfast' | 'lunch' | 'dinner' | 'snack'
  recipeId   String?
  recipe     Recipe?  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  customName String?
  servings   Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, date])
  @@index([recipeId])
}

// Per-100g nutrition cache per ingredient (static table + USDA FoodData
// Central lookups land here so each ingredient is fetched at most once).
model IngredientNutrition {
  id        String   @id @default(uuid())
  name      String   @unique
  calories  Float
  protein   Float
  carbs     Float
  fat       Float
  source    String // 'STATIC' | 'USDA' | 'NONE' (USDA has no such food; zeros, read as unknown)
  createdAt DateTime @default(now())
}

// Packaged foods looked up by barcode on Open Food Facts, cached forever so
// each product is fetched at most once (and scanning works when OFF is down).
model FoodProduct {
  barcode      String   @id
  name         String
  brand        String?
  servingGrams Float?
  calories     Float // per 100 g
  protein      Float
  carbs        Float
  fat          Float
  createdAt    DateTime @default(now())
  // When the data was last read from OFF; older than ~6 months, the next
  // scan refreshes it in the background (recipes and labels change).
  fetchedAt    DateTime @default(now())
}

// A barcode Open Food Facts doesn't know, remembered for a few days so
// repeat scans of it don't each wait on OFF. Deleted when OFF has it.
model BarcodeMiss {
  barcode   String   @id
  checkedAt DateTime @default(now())
}

// A dish this user has scanned and logged, with the portion they logged
// last time ("3 idli + 1 katori sambar"). The next scan the scanner names
// the same way offers it as "your usual". Keyed like MealScanCorrection
// (correctionKey: case, word order and filler words don't matter).
model UserDish {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dishKey     String
  name        String
  // MealPhotoItem[] as last logged (already scaled to the portion eaten).
  items       Json
  calories    Int
  protein     Int
  carbs       Int
  fat         Int
  timesEaten  Int      @default(1)
  lastEatenAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@unique([userId, dishKey])
  @@index([userId, lastEatenAt])
}

// A packaged food this user logged: a scanned label (kept whole, so it can
// be logged again without the camera) or a barcode product (only how much
// they usually have; the product data lives in FoodProduct).
// foodKey: "label:<name key>" or "barcode:<code>".
model UserFood {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  foodKey       String
  name          String
  barcode       String?
  // NutritionLabelAnalysis as read off the pack (label foods only).
  label         Json?
  usualGrams    Float?
  usualServings Float?
  timesLogged   Int      @default(1)
  lastLoggedAt  DateTime @default(now())
  createdAt     DateTime @default(now())

  @@unique([userId, foodKey])
  @@index([userId, lastLoggedAt])
}

// How often a recipe was recommended to a user: one row per (user, recipe),
// counted up in place. It replaces a UserEvent row per recipe per
// recommendation, which made 'suggest' the bulk of that table. The count
// restarts when the last suggestion is older than the taste window, so
// "suggested N times and ignored" keeps meaning "recently".
model RecipeSuggestion {
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipeId String
  recipe   Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  count    Int      @default(1)
  firstAt  DateTime @default(now())
  lastAt   DateTime @default(now())

  @@id([userId, recipeId])
  @@index([userId, lastAt])
  @@index([recipeId])
}

// Implicit-feedback log driving recommendations: every search, recipe view,
// grocery add and chat message becomes a weighted taste signal.
model UserEvent {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // 'search' | 'view' | 'grocery' | 'chat' | 'suggest'
  recipeId  String?
  term      String?
  weight    Float
  createdAt DateTime @default(now())

  // Every read is by user and type (signals, 'view' history), newest first;
  // this index serves them all, so (userId, createdAt) was dropped.
  @@index([userId, type, createdAt])
  // (No recipeId index: recipeId has no foreign key and no query filters on
  // it alone, so it was pure write cost on the busiest table.)
  // Retention sweeps delete by age across all users.
  @@index([createdAt])
}

model NutritionGoals {
  id       String @id @default(uuid())
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  calories Int    @default(980)
  carbs    Int    @default(44)
  protein  Int    @default(81)
  fat      Int    @default(18)
}

// One water intake entry; multiple per day are allowed and summed for the
// daily total. Date is day granularity (UTC midnight) like MealPlanEntry.
model WaterLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date // a calendar day, no time part
  ml        Int
  createdAt DateTime @default(now())

  @@index([userId, date])
}

// One weigh-in per day — a second entry for the same day overwrites the
// first (upsert on the (userId, date) unique key).
model WeightEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date // a calendar day, no time part
  kg        Float
  note      String?
  createdAt DateTime @default(now())

  @@unique([userId, date])
}

model GroceryItem {
  id     String  @id @default(uuid())
  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name   String
  // Denormalized so the grocery list can still group/label the item by
  // recipe after the recipe is edited or removed (TheMealDB re-import etc).
  recipeId   String?
  recipe     Recipe?  @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  recipeName String?
  // What the recipe calls for ("500 g"), copied from its ingredient line.
  quantity   String?
  checked    Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  // Shop-a-recipe and "add the week to grocery" look items up by recipe.
  @@index([userId, recipeId])
  @@index([recipeId])
}

model Recipe {
  id           String         @id @default(uuid())
  externalId   String?        @unique
  name         String
  nameLower    String
  category     String
  cuisine      String
  imageUrl     String?
  instructions String
  prepMinutes  Int?
  cookMinutes  Int?
  source       String         // 'MEALDB' | 'AI'
  // Real per-serving nutrition, lazily computed from ingredients (USDA data).
  calories     Int?
  protein      Int?
  carbs        Int?
  fat          Int?
  // Estimated servings the macros above are divided by (sources carry none).
  // Null = computed before estimation existed; recomputed on next access.
  servings     Int?
  // Grams in one serving of the finished dish (total weight ÷ servings).
  servingGrams Int?
  // Servings the recipe itself states (curated or AI-written); when set it
  // replaces the weight-based estimate above.
  declaredServings Int?
  // What users do with the recipe, recomputed daily (recipeQuality.ts):
  // distinct users who saved, logged or planned it, minus twice those who
  // said "not for me". AI recipes far below zero are hidden from lists.
  qualityScore Int            @default(0)
  ingredients  Ingredient[]
  insights     RecipeInsight?
  searchTerms  SearchTerm[]
  mealLogs     MealLog[]
  favorites    Favorite[]
  mealPlanEntries MealPlanEntry[]
  groceryItems GroceryItem[]
  suggestions  RecipeSuggestion[]
  createdAt    DateTime       @default(now())

  // by-cuisine pages ORDER BY name, id — the composite serves filter and
  // order without a sort, and its leading column still serves DISTINCT cuisine.
  @@index([cuisine, name])
  // nameLower is only ever queried with `contains`, which compiles to
  // LIKE '%term%' — a btree cannot serve that, so a trigram GIN replaces it.
  @@index([nameLower(ops: raw("gin_trgm_ops"))], map: "Recipe_nameLower_trgm_idx", type: Gin)
}

model Ingredient {
  id       String @id @default(uuid())
  recipeId String
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  name     String
  measure  String
  position Int

  // Serves "this recipe's ingredients, in order" without a sort.
  @@index([recipeId, position])
}

model RecipeInsight {
  id        String   @id @default(uuid())
  recipeId  String   @unique
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  content   String
  provider  String
  createdAt DateTime @default(now())
}

model SearchTerm {
  id       String @id @default(uuid())
  term     String @unique
  recipeId String
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId])
}
