# --- Database (local PostgreSQL) ---
# URL-encode special chars in the password (e.g. @ -> %40).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nutrichef

# --- API ---
PORT=4000

# Secret used to sign auth tokens. Set a long random value in production
# (at least 32 chars; e.g. `openssl rand -base64 48`).
AUTH_SECRET=change-me-to-a-long-random-string

# Browser origins allowed by CORS, comma-separated (e.g. Expo web). The native
# app needs none. Empty = any origin in development, none in production.
CORS_ORIGINS=

# Shown as the contact address in the privacy policy and terms served at
# /privacy and /terms. Required before App Store submission.
SUPPORT_EMAIL=

# --- AI: configure ANY subset; order = fallback priority ---
AI_PROVIDER_ORDER=ollama,ollama-vision,zai,gemini,openai,anthropic,mistral,kimi,openrouter

OLLAMA_BASE_URL=http://localhost:11434
# Same free Ollama cloud model for text (recipe generation, chat, coach) and
# vision (meal-photo scanner, nutrition-label OCR) — one model, one sign-in.
OLLAMA_MODEL=gemma4:31b-cloud
OLLAMA_VISION_MODEL=gemma4:31b-cloud

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

KIMI_API_KEY=
KIMI_MODEL=moonshot-v1-8k

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# USDA FoodData Central API key for real ingredient nutrition (free:
# https://fdc.nal.usda.gov/api-key-signup/). Falls back to DEMO_KEY
# (30 req/hr) — fine for testing since every lookup is cached in the DB.
FDC_API_KEY=

# Pexels stock photo API — used only by `npm run db:backfill-images`.
PEXELS_API_KEY=

# Z.ai (Zhipu) — GLM-4.7-Flash is free: key at https://open.bigmodel.cn
ZAI_API_KEY=
ZAI_MODEL=glm-4.7-flash
